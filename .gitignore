.DS_Store
node_modules/
*.log
__pycache__/
*.pyc

# Personal drafts / working documents, not part of the plugin, never committed.
.local/

# SDR signal data contains third-party prospect PII (names, titles, companies,
# and eventually reply/DM content) — unlike data/social this must never be
# committed. See data/sdr/README.md.
data/sdr/*.jsonl

# Ads data holds a business's spend, cost per lead, Meta account/campaign IDs, and
# unreleased creative. psstack is a public repo, so only data/ads/README.md and the
# schemas are tracked. See data/ads/README.md.
data/ads/*.jsonl
data/ads/assets/
data/ads/learnings.md
# /ps:executive-report archive: customer names, unreleased work, and raw notes with
# real names. Only the README is tracked. See data/reports/README.md.
data/reports/*
!data/reports/README.md
# /ps:observe run logs: repo internals and unreleased work from the session under test.
# Only the README is tracked; learnings are committed as process fixes instead.
data/runs/*
!data/runs/README.md
